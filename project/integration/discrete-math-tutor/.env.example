# 复制为 .env 后填入自己的密钥；不要分享 .env。
DEEPSEEK_API_KEY=your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_VISION_MODEL=deepseek-flash
# 0=调用真实模型；填入上面的密钥后保持为 0。
# 仅离线检查注册/历史保存流程时改成 1；模拟回复是固定测试模板。
LLM_MOCK=0
DATABASE_URL=sqlite:///./ai_tutor.db
# HTTPS 正式部署设为 1；本机 http://127.0.0.1 开发可留空自动判断。
# AUTH_COOKIE_SECURE=1
# 旧 MySQL 数据库先备份，再设为 1 允许增量建表；SQLite 首次迁移自动备份。
# ALLOW_EXISTING_DB_MIGRATION=1
