# 复制为 .env 后填入自己的密钥；不要分享 .env。
DEEPSEEK_API_KEY=your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_VISION_MODEL=deepseek-flash
# 1=无网络模拟流程；0=调用真实模型。
LLM_MOCK=1
DATABASE_URL=sqlite:///./ai_tutor.db
# 可选：中文交叉编码器重排。首次下载约 1 GB，本机 CPU 检索约需数秒。
# RAG_RERANK_MODEL=BAAI/bge-reranker-base
# sigmoid 后的相关性分数门槛，未经概率校准；仅用开发集调整。
# RAG_RERANK_MIN_PROBABILITY=0.15

# 小模型设备：cpu 或 cuda；cuda 需要 GPU 环境。
# RAG_RERANK_DEVICE=cpu
# RAG_EMBED_DEVICE=cpu

# 后台记忆：默认规则摘要；开启 LLM 后使用现有模型，每个新回合最多三次任务尝试。
MEMORY_WORKER_ENABLED=1
MEMORY_REFLECTION_LLM=0

# 意图识别灰度（API聊天入口）；all保持当前行为，test只开放测试账户。
# allowlist只开放逗号分隔的学生ID；off回退旧字段识别。
INTENT_ROLLOUT=all
INTENT_STUDENT_ALLOWLIST=
INTENT_CONTEXT_ENABLED=1
INTENT_TASK_ENABLED=1
INTENT_CLARIFICATION_ENABLED=1
# 自由改写尚未实现，必须保持0。
INTENT_REWRITE_ENABLED=0
# 对话辅助图试点：默认关闭；test 为本机测试账户，allowlist 限测试账户白名单。
VISUALIZATION_ROLLOUT=off
VISUALIZATION_STUDENT_ALLOWLIST=
# 按需Skill与模板生成；仍受VISUALIZATION_ROLLOUT账户范围控制。
# 每轮最多选择两种模板，总模型预算40秒，失败保留已核验的文字回答。
VISUALIZATION_ON_DEMAND=0
