# 复制为 .env 后填入自己的密钥；不要分享 .env。
DEEPSEEK_API_KEY=your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_VISION_MODEL=deepseek-flash
# 1=无网络模拟流程；0=调用真实模型。
LLM_MOCK=1
DATABASE_URL=sqlite:///./ai_tutor.db
# 当前正式教材。
TUTOR_COURSE=experimental-psychology-3
# 独立 DeepTutor 后端；已接状态、能力与空会话绑定，不切换教学模型。
DEEPTUTOR_BACKEND_URL=http://127.0.0.1:18001
# 宿主和 worker 共用；生成至少32字符的随机凭据，留空时禁止数据接口。
DEEPTUTOR_BRIDGE_TOKEN=
# 1=已核验回答保存后自动绑定上游课程/空会话；默认保持原入口。
DEEPTUTOR_SESSION_SYNC=0
# 1=保存任务版本/来源指针到上游回合事件，启用游标恢复；不切换生成模型。
# 自动包含会话绑定，不要求同时开启SESSION_SYNC。
DEEPTUTOR_TURN_SYNC=0
# 1=通过本机 DeepTutor Provider 调用宿主配置的模型；失败不绕过网关。
DEEPTUTOR_LLM_ENABLED=0
# 1=教材讲解使用原生多轮 AgentLoop；需同时启用模型网关，仍经过原教学/引用核验。
DEEPTUTOR_AGENTIC_ENABLED=0
# P1 内部原生持久化协议试验；宿主发布/删除和页面未接通前保持0。
DEEPTUTOR_NATIVE_ENABLED=0
# 1=在原检索结果中补充已发布的 DeepTutor Obsidian 教材命中；需先发布教材。
DEEPTUTOR_KNOWLEDGE_ENABLED=0
# 心理学模式自动使用独立SQLite文件；其他数据库需显式指定独立库，不能复用旧课程库。
# COURSE_DATABASE_URL=sqlite:///./experimental_psychology.db
# 可选：中文交叉编码器重排。首次下载约 1 GB，本机 CPU 检索约需数秒。
# RAG_RERANK_MODEL=BAAI/bge-reranker-base
# sigmoid 后的相关性分数门槛，未经概率校准；仅用开发集调整。
# RAG_RERANK_MIN_PROBABILITY=0.15
# Q2本地代码集成试点：先安装requirements-local-rag.txt；默认保留当前检索。
RAG_RETRIEVAL_ENGINE=legacy
# 试点值：local_llamaindex；在本项目进程运行BM25/向量RRF，不依赖DeepTutor服务。
# RAG_RETRIEVAL_PROFILE=hybrid

# 小模型设备：cpu 或 cuda；cuda 需要 GPU 环境。
# RAG_RERANK_DEVICE=cpu
# RAG_EMBED_DEVICE=cpu

# 后台记忆：默认规则摘要；开启 LLM 后使用现有模型，每个新回合最多三次任务尝试。
MEMORY_WORKER_ENABLED=1
MEMORY_REFLECTION_LLM=0

# 意图识别灰度（API聊天入口）；all保持当前行为，test只开放测试账户。
# allowlist只开放逗号分隔的学生ID；off回退旧字段识别。
INTENT_ROLLOUT=all
INTENT_STUDENT_ALLOWLIST=
INTENT_CONTEXT_ENABLED=1
INTENT_TASK_ENABLED=1
INTENT_CLARIFICATION_ENABLED=1
# 自由改写尚未实现，必须保持0。
INTENT_REWRITE_ENABLED=0
# 对话辅助图试点：默认关闭；test 为本机测试账户，allowlist 限测试账户白名单。
VISUALIZATION_ROLLOUT=off
VISUALIZATION_STUDENT_ALLOWLIST=
# 按需Skill与模板生成；心理学课程按教学需要自动调用。
# 每轮最多选择两种模板，总模型预算40秒，失败保留已核验的文字回答。
VISUALIZATION_ON_DEMAND=1

# Q5 first learning-path batch (plan/position/restore); default off.
Q5_LEARNING_ENABLED=0
