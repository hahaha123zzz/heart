+        "/api/knowledge-bases/{kb_name}/files/{filename:path}",
+        "/api/knowledge-bases/{kb_name}/file-preview-text/{filename:path}",
+        "/api/knowledge-bases/{kb_name}/visual-assets/{asset_id}",
+        "/api/knowledge-bases/{kb_name}/indexing-run",
