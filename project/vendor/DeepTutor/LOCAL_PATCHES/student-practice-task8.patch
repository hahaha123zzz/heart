+            {count}
+          </span>
+        ) : null}
+      </header>
+      {children}
+    </section>
+  );
+}
+
+function SpaceSubsection({
+  category,
+  count,
+  children,
+}: {
+  category: SpaceCategoryDef;
+  count: number;
+  children: ReactNode;
+}) {
+  const Icon = category.icon;
+  const { t } = useTranslation();
