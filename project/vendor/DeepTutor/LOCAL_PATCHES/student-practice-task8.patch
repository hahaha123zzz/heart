+              </span>
+              <button
+                type="button"
+                disabled={(bank.page + 1) * 60 >= bank.total || bank.refreshing}
+                onClick={() => bank.setPage(bank.page + 1)}
+                className="rounded-lg border border-[var(--border)] px-3 py-2 disabled:opacity-40"
+              >
+                {t("Next page")}
+              </button>
+            </nav>
+          )}
