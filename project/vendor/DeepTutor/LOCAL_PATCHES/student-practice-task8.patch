+    } catch (err) {
+      setError(err instanceof Error ? err.message : String(err));
+    } finally {
+      pending.current = false;
+      setStarting(false);
+    }
+  }
+  function switchTab(view: "bank" | "mistakes") {
+    const next = new URLSearchParams(search.toString());
+    next.set("view", view);
