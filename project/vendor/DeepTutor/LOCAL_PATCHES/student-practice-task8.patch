+    ) -> dict[str, int]:
+        """Counts behind the bank's filter chips (and the agent's overview)."""
+        return await self._run(
+            self._question_bank_stats_sync,
+            None if session_ids is None else tuple(session_ids),knowledge_point_id,mastery_path_id,
+        )
