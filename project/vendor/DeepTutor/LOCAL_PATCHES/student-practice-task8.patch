+                    FROM messages AS m, json_each(m.events_json) AS event
+                    WHERE m.session_id = turns.session_id
+                      AND m.role = 'assistant'
+                      AND json_extract(event.value, '$.type') = 'done'
+                      AND json_extract(event.value, '$.turn_id') = turns.id
