+                    title={topic.name || topic.metadata.goal}
+                    icon={<Route size={19} />}
+                    subtitle={t('{{count}} reviews due', {
+                      count: topic.reviews.filter(review => review.due).length,
+                    })}
+                    onClick={() =>
