+def _independent_evidence(context: dict) -> bool:
+    verification = context.get("verification")
+    assistance = context.get("assistance")
+    return (("independent" not in context or context["independent"] is True)
+            and (verification is None or verification in ("rule_verified", "reviewed_key", "reviewed_rubric"))
+            and not context.get("teaching_after_question")
+            and not context.get("hints_used")
+            and (not assistance or isinstance(assistance, dict) and not any(
+                assistance.get(key) for key in ("events", "hints_used", "max_hint_level", "examples_used",
+                                               "explanations_used", "full_explanation_seen"))))
+
