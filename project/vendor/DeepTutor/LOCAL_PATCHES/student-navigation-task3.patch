-function formatDay(key: string, lang: string): string {
-  const d = new Date(`${key}T00:00:00`);
-  if (Number.isNaN(d.getTime())) return key;
-  return d.toLocaleDateString(lang, {
-    year: "numeric",
-    month: "short",
-    day: "numeric",
-    weekday: "short",
-  });
-}
