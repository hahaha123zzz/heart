+              ]
+                .filter(Boolean)
+                .join(" · ")}
+              onClick={() => onDecide("reuse")}
+            />
+            <DecisionChip
+              active={item.decision === "separate"}
+              label={t("Upload as a new one")}
+              detail={formatBytes(item.sizeBytes)}
+              onClick={() => onDecide("separate")}
