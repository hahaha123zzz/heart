-          materialIds.push(uploaded.material_id);
-        }
-      }
-
-      let workspace: ReadingWorkspace | undefined;
-      if (mode === "create") {
-        const name =
-          title.trim() || items[0].label.replace(/\.[^.]+$/, "").slice(0, 80);
-        if (urlsToImport.length) {
