-// ── TabStrip ────────────────────────────────────────────────────────
-
-interface TabStripProps {
-  tab: Tab;
-  onChange: (tab: Tab) => void;
-  l2Count: number;
-  l3Count: number;
-  t: (key: string, opts?: Record<string, unknown>) => string;
