+        {
+          locator: segment.locator,
+          kind: kind === "note" ? "highlight" : kind,
+          color,
+          quote: segment.quote,
+          note,
+          rects: segment.rects,
+          source_anchor: selection.sourceAnchor ?? "",
+          selectors: selection.selectors ?? [],
+        },
+        {
+          annotation_id: `${temporaryId}-${segment.locator}`,
+          locator: segment.locator,
