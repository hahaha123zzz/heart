+          color,
+          quote: segment.quote,
+          note,
+          rects: segment.rects,
+          source_anchor: selection.sourceAnchor ?? "",
+          selectors: selection.selectors ?? [],
+          author: "user",
+          created_at: now,
+          updated_at: now,
