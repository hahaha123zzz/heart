-        self,
-        tool_name: str,
-        kwargs: dict[str, Any],
-        context: UnifiedContext,
-    ) -> dict[str, Any]:
-        """Bind the open material to this capability's tools, server-side.
-
-        The model never names a material, so it can neither read a document the
