-    # -- seeds ------------------------------------------------------------
-
-    def pre_loop_seed(self, context: UnifiedContext) -> str:
-        """Report the viewport — synchronous, and cheap enough to run inline.
-
-        Kept separate from the locate pre-pass so that "the user is looking at
