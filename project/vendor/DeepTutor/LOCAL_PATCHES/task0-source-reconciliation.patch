-      "border-bottom-width",
-      "border-left-width",
-      "padding-top",
-      "padding-right",
-      "padding-bottom",
-      "padding-left",
-      "font-style",
-      "font-variant",
-      "font-weight",
-      "font-stretch",
-      "font-size",
-      "font-size-adjust",
-      "line-height",
-      "font-family",
-      "letter-spacing",
-      "text-align",
-      "text-transform",
-      "text-indent",
-      "tab-size",
