-      const reader = response.body.getReader();
-      const decoder = new TextDecoder();
-      let buffer = "";
-      let finalResult: StreamEditResult | undefined;
-
-      const processSseChunk = (chunk: string) => {
-        const lines = chunk.split(/\r?\n/);
