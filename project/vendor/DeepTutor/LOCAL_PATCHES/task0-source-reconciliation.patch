-        if (eventName === "stream") {
-          updateSelectionTraceFromEvent(payload as StreamTraceEvent);
-          return;
-        }
-        if (eventName === "result") {
-          finalResult = payload as StreamEditResult;
-          return;
-        }
-        if (eventName === "error") {
-          throw new Error(
-            String(payload?.detail || t("Failed to edit selected text.")),
-          );
-        }
-      };
