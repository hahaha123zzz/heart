+    def record_chat_reference(self, path_id: str, *, session_id: str, turn_id: str, payload: dict) -> None:
+        """只保存引用暴露的最小审计信息，重复完成通知不产生新事件。"""
+        def record(tx):
+            existing = tx._conn.execute("""SELECT 1 FROM mastery_events
+                WHERE path_id=? AND event_type='chat.reference_provided' AND session_id=? AND turn_id=?""",
+                (path_id, session_id, turn_id)).fetchone()
+            if existing is None:
+                tx.emit("chat.reference_provided", payload, session_id=session_id, turn_id=turn_id)
+        self.mutate(path_id, record)
+
