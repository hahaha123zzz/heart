+            "mcp_tools": [],
+            "cli_apps": [],
+            "exec_enabled": False,
+            "learning_policy": {
+                "age_band": "9-12",
+                "locked_persona": "teacher",
+                "allowed_capabilities": ["chat", "immersive_reading"],
+                "default_capability": "immersive_reading",
+                "allowed_surfaces": ["chat", "reading"],
+                "reading": {
+                    "allow_upload": False,
+                    "material_ids": [],
+                    "extensions": [],
+                },
+            },
+        },
+    )
