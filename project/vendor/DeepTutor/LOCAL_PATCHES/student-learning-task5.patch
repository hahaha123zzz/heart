+        (
+            "/api/knowledge-bases/kb1/reindex-config",
+            "/api/knowledge-bases/{kb_name}/reindex-config",
+            "",
+        ),
+        (
+            "/api/knowledge-bases/kb1/linked-folders",
+            "/api/knowledge-bases/{kb_name}/linked-folders",
+            "",
+        ),
+        (
+            "/api/knowledge-bases/kb1/github-sources",
