+def _validation_message(exc: ValidationError) -> str:
+    parts = []
+    for error in exc.errors():
+        location = ".".join(str(item) for item in error.get("loc", ()))
+        parts.append(f"{location or 'row'}: {error.get('msg', 'Invalid value')}")
+    return "; ".join(parts)
