    {"id": "learning", "current_engine": "TaskService -> Q5Runtime/SessionStudyService -> Q3", "state_objects": ["goal_path_position", "session_study_plan", "textbook_navigation", "published_conversation_and_citation"], "future_capability": "原生mastery；Q2仍决定教材下一目标"},
    {"id": "selection", "current_engine": "TaskService -> selection_loop；区域/关闭开关走explain_selection", "state_objects": ["textbook_release_and_sources", "formative_pending_question", "published_conversation_and_citation"], "future_capability": "原生chat/mastery的受控选区工具"},
    {"id": "practice", "current_engine": "practice_api独立服务；聊天帮助走explain_exercise", "state_objects": ["exercise_submission_and_grade", "formative_observation", "published_conversation_and_citation"], "future_capability": "原生调用原练习业务；不自动升级掌握"},
    {"id": "ask_user", "current_engine": "TaskService -> 保存的Q3 loop_state恢复", "state_objects": ["active_turn_execution", "request_receipt_revision_epoch", "formative_pending_question"], "future_capability": "NativeTurnReply继续同turn；结构化多问题契约仍待NT1"}
